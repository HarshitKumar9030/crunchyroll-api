{
  "name": "crunchy-api",
  "version": "0.1.1",
  "description": "Unofficial Crunchyroll API client for watchlists, history, crunchylists, and episode metadata.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "rimraf dist",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "crunchyroll",
    "anime",
    "api",
    "history",
    "watchlist",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "rimraf": "^6.0.1",
    "typescript": "^5.9.2"
  }
}