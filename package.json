{
  "name": "crunchy-api",
  "version": "0.2.0",
  "description": "Unofficial Crunchyroll API client for watchlists, history, crunchylists, and episode metadata.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test test/*.test.mjs",
    "check": "npm run typecheck && npm test && npm run test:package",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "npm run check",
    "test:package": "node scripts/verify-package.mjs",
    "web": "npm run build && node web/studio/server.mjs",
    "web:build": "node web/studio/build.mjs",
    "test:web": "npm run web:build && node --test web/studio/test/*.test.mjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "keywords": [
    "crunchyroll",
    "anime",
    "api",
    "history",
    "watchlist",
    "typescript"
  ],
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "typescript": "^7.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/HarshitKumar9030/crunchyroll-api.git"
  },
  "bugs": {
    "url": "https://github.com/HarshitKumar9030/crunchyroll-api/issues"
  },
  "homepage": "https://github.com/HarshitKumar9030/crunchyroll-api#readme"
}
